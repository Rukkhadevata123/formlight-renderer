cmake_minimum_required(VERSION 4.5)
string(RANDOM LENGTH 12 nonce)
set(scratch "${CMAKE_CURRENT_BINARY_DIR}/external-gltf-${nonce}")
file(MAKE_DIRECTORY "${scratch}/work")
file(COPY "${ASSETS}/DualUvPanel" DESTINATION "${scratch}")
set(model "../DualUvPanel/DualUvPanel.gltf")

function(run_cli expected_status expected_text)
    execute_process(COMMAND "${RENDERER}" ${ARGN} WORKING_DIRECTORY "${scratch}/work"
        RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(FIND "${out}${err}" "${expected_text}" match)
    if(NOT status EQUAL expected_status OR match EQUAL -1)
        message(FATAL_ERROR "${ARGN} returned ${status}: ${out}${err}")
    endif()
endfunction()

foreach(mode raster hybrid)
    run_cli(0 "Wrote" --render "${ASSETS}/DualUvPanel.glb" --mode ${mode} --output embedded.png)
    run_cli(0 "Wrote" --render "${model}" --mode ${mode} --output external.png)
    file(SHA256 "${scratch}/work/embedded.png" embedded)
    file(SHA256 "${scratch}/work/external.png" external)
    if(NOT embedded STREQUAL external)
        message(FATAL_ERROR "${mode}: external geometry or texture differs from the GLB")
    endif()
endforeach()

set(texture "../DualUvPanel/textures/two texels.png")
run_cli(1 "overwrite" --render "${model}" --output "${texture}")
file(REMOVE "${scratch}/work/${texture}")
run_cli(0 "Instanced triangles: 2" --inspect "${model}")
run_cli(1 "two texels.png" --render "${model}" --pixel 320 240)
file(WRITE "${scratch}/work/${texture}" "invalid PNG")
run_cli(1 "two texels.png" --render "${model}" --pixel 320 240)
set(buffer "${scratch}/DualUvPanel/buffers/panel.bin")
file(WRITE "${buffer}" "short")
run_cli(1 "file contains 5" --inspect "${model}")
file(REMOVE "${buffer}")
run_cli(1 "panel.bin" --inspect "${model}")
file(REMOVE_RECURSE "${scratch}")
